            col(
                f"{fmt_erg(e['local_payout'])} ERG",
                BOLD,
                GREEN if e["local_payout"] > 0 else YELLOW
            )
        ),
        compact_kv(
            "Local direct DEX net",
            col(
                f"{fmt_erg(e['local_dex_net'])} ERG",
