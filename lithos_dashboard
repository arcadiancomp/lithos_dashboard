# Data helpers
# ─────────────────────────────────────────────────────────────────────────────

NANO = Decimal("1000000000")


def dec(v, default="0"):
    try:
        if v is None:
            return Decimal(default)
        return Decimal(str(v))
    except (InvalidOperation, ValueError, TypeError):
        return Decimal(default)


def integer(v, default=0):
    try:
        return int(v)
    except (ValueError, TypeError):
        return default


def erg(totals, key):
    return dec(totals.get(key, "0")) / NANO


def num(totals, key):
    return integer(totals.get(key, "0"))


def fmt_erg(v, places=3):
    v = dec(v)
    if abs(v) >= Decimal("1000"):
        return f"{v:,.1f}"
    return f"{v:,.{places}f}"


def fmt_rate(v):
    v = dec(v)
    return f"{v:,.2f}"


def fmt_pct(v):
    return f"{float(v):+.1f}%"


def api_get(base, path, params=None, timeout=4, max_response_bytes=MAX_RESPONSE_BYTES):
    base = normalize_base_url(base)
    url = base + path

    if params:
        url += "?" + urllib.parse.urlencode(params)

    req = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": f"LithosDashboard/{VERSION}",
        }
    )

    with urllib.request.urlopen(req, timeout=timeout) as response:
        content_length = response.headers.get("Content-Length")
        if content_length:
            try:
                declared = int(content_length)
            except ValueError:
                declared = 0
            if declared > max_response_bytes:
                raise ValueError(
                    f"API response exceeds {max_response_bytes} bytes "f"({urllib.parse.urlsplit(url).path})"
                )

        raw = response.read(max_response_bytes + 1)

    if len(raw) > max_response_bytes:
        raise ValueError(
            f"API response exceeds {max_response_bytes} bytes "f"({urllib.parse.urlsplit(url).path})"
        )

    return sanitize_json(json.loads(raw.decode("utf-8")))


def fetch_payment_ledger(base, timeout=10, page_limit=500):
    """Fetch a complete Lithos payment ledger using its documented offset API.

    The node caps a single page at 500 rows. Pages are requested oldest-first,
    so newly confirmed payouts normally append rather than displace older rows.
    Freeze the initial total: any later additions will appear on the next read.
    Claims and bounties are full snapshots included on *every* response; take
    those only from the initial page instead of concatenating duplicates.

    On a too-large JSON reply, halve the current page size without disabling
    the generic 2MiB response guard. Reject missing or overlapping pages.
    """
    if not isinstance(page_limit, int) or isinstance(page_limit, bool) or not 1 <= page_limit <= 500:
        raise ValueError("payment page_limit must be an integer between 1 and 500")

    offset = 0
    target_total = None
    first = None
    payments = []
    seen_outputs = set()
    while target_total is None or offset < target_total:
        count = page_limit if target_total is None else min(page_limit, target_total - offset)
        while True:
            try:
                doc = api_get(
                    base, "/stats/mining/payments",
                    params={"offset": offset, "limit": count, "sort": "paid", "order": "asc"},
                    timeout=timeout,
                )
                break
            except ValueError as exc:
                if "API response exceeds" not in str(exc) or count == 1:
                    raise
                count = max(1, count // 2)

        if not isinstance(doc, dict):
            raise ValueError("Lithos payment page is not an object")
        if doc.get("status") != "ready":
            if offset:
                raise ValueError("Lithos payment ledger became unavailable during pagination")
            return doc
        rows = doc.get("payments")
        total = doc.get("total")
        page_offset = doc.get("offset")
        if not isinstance(rows, list):
            raise ValueError("Lithos payment page has no payments list")
        if not isinstance(total, int) or isinstance(total, bool) or total < 0:
            raise ValueError("Lithos payment page has an invalid total")
        if page_offset != offset or not isinstance(page_offset, int) or isinstance(page_offset, bool):
            raise ValueError("Lithos payment page returned an unexpected offset")
        if first is None:
            first = doc
            target_total = total
        elif total < target_total:
            raise ValueError("Lithos payment total shrank during pagination; retry this snapshot")
        needed = min(count, target_total - offset)
        if len(rows) != needed:
            raise ValueError(
                f"Incomplete Lithos payment page at offset {offset}: expected {needed}, received {len(rows)}"
            )
        for row in rows:
            if not isinstance(row, dict) or not isinstance(row.get("outputId"), str) or not row["outputId"]:
                raise ValueError("Lithos payment row has no valid outputId")
            output_id = row["outputId"]
            if output_id in seen_outputs:
                raise ValueError(f"Duplicate Lithos payment outputId at offset {offset}: {output_id}")
            seen_outputs.add(output_id)
        payments.extend(rows)
        offset += len(rows)
        page_limit = min(page_limit, count)  # Remember the last successful safe page size.

    # Return the API's original shape. Only 'payments' is aggregated; each page
    # includes the entire claim/bounty snapshot and must not be combined there.
    return dict(first, payments=payments, offset=0, total=target_total)


def ms_date(ms):
    if not ms:
        return "-"
    return datetime.fromtimestamp(
        int(ms) / 1000,
        tz=timezone.utc
    ).strftime("%Y-%m-%d")


def ms_datetime(ms):
    if not ms:
        return "-"
    return datetime.fromtimestamp(
        int(ms) / 1000,
        tz=timezone.utc
    ).strftime("%Y-%m-%d %H:%M:%S UTC")


def hr(char="─"):
    width = shutil.get_terminal_size((150, 40)).columns
    width = max(90, min(width, 180))
    return col(char * width, DIM)


def section(title):
    print()
    print(col(f"  {title}", BOLD, CYAN))
    print(hr())


def kv(label, value, label_width=28):
    print(
        "  "
        + col(f"{label:<{label_width}}", DIM)
        + str(value)
    )


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def visible_len(value):
    return len(ANSI_RE.sub("", str(value)))


def pad_ansi(value, width):
    value = str(value)
    return value + (" " * max(0, width - visible_len(value)))


def compact_kv(label, value, label_width=23):
    return (
        "  "
        + col(f"{label:<{label_width}}", DIM)
        + str(value)
    )


def print_columns(left_title, left_lines, right_title, right_lines):
    # ANSI-aware side-by-side panels for wide, low-height terminals.
    terminal_width = shutil.get_terminal_size((150, 40)).columns
    total_width = max(120, min(terminal_width, 180))
    gap = 4
    panel_width = (total_width - gap) // 2

    left_heading = col(f"  {left_title}", BOLD, CYAN)
    right_heading = col(f"  {right_title}", BOLD, CYAN)

    print()
    print(
        pad_ansi(left_heading, panel_width)
        + (" " * gap)
        + right_heading
    )
    print(
        col("─" * panel_width, DIM)
        + (" " * gap)
        + col("─" * panel_width, DIM)
    )

    rows = max(len(left_lines), len(right_lines))
    for i in range(rows):
        left = left_lines[i] if i < len(left_lines) else ""
        right = right_lines[i] if i < len(right_lines) else ""
        print(
            pad_ansi(left, panel_width)
            + (" " * gap)
            + right
        )


