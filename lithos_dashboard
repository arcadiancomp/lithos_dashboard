ADOPTION_WINDOWS = (100, 500, 1000)
ADOPTION_MAX_BLOCKS = max(ADOPTION_WINDOWS)
CHAIN_SLICE_BATCH = 128


def default_adoption_state_file():
    root = os.environ.get("XDG_STATE_HOME")
    if not root:
        root = os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(
        root,
        "lithos_dashboard",
        "adoption_history.json"
    )


def empty_adoption_state():
    return {
        "version": 1,
        "holdingErgoTree": None,
        "lastTip": None,
        "records": {},
    }


def load_adoption_state(path):
    state = empty_adoption_state()

    try:
        with open(path, "r", encoding="utf-8") as fh:
            saved = json.load(fh)

        if isinstance(saved, dict) and saved.get("version") == 1:
            state.update(saved)

        if not isinstance(state.get("records"), dict):
            state["records"] = {}

    except FileNotFoundError:
        pass
    except (OSError, ValueError, TypeError):
        pass

    return state


def save_adoption_state(path, state):
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)

    tmp = path + ".tmp"

    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
        fh.write("\n")

    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def discover_holding_tree(node_base, stats_doc, state):
    """
    Learn the canonical Lithos Holding ErgoTree from a confirmed genesis
    transaction reported by the local Lithos client.

    Once learned it is persisted, so a temporary lack of recent Lithos blocks
    does not disable network adoption tracking.
    """
    mining = (stats_doc or {}).get("mining") or {}
    blocks = mining.get("blocks") or []

    if isinstance(blocks, list):
        for block in blocks:
            if not isinstance(block, dict):
                continue

            txid = safe_text(block.get("transactionId", "")).strip()
            if not txid:
                continue

            try:
                tx = api_get(
                    node_base,
                    "/blockchain/transaction/byId/"
                    + urllib.parse.quote(txid, safe=""),
                    timeout=8
                )
            except Exception:
                continue

            outputs = tx.get("outputs") or []
            if not outputs or not isinstance(outputs[0], dict):
                continue

            tree = safe_text(outputs[0].get("ergoTree", "")).strip()
            if tree:
                return tree

    cached = safe_text(state.get("holdingErgoTree") or "").strip()
    if cached:
        return cached

    raise ValueError(
        "cannot learn Lithos Holding contract: no recent confirmed genesis "
        "is available and no cached fingerprint exists"
    )


def fetch_chain_headers(node_base, start_height, end_height):
    """Read a height window using bounded Ergo 6.0.6 chain slices.

    Despite the OpenAPI range description, Ergo 6.0.6's implementation
    returns heights (fromHeight, toHeight]. The requested inclusive
    window [first, last] therefore uses (first - 1, last) on the wire.
    Keep the global 2 MiB response guard intact.
    """
    if end_height < start_height:
        return []

    headers = []
    for first in range(start_height, end_height + 1, CHAIN_SLICE_BATCH):
        after_last = min(first + CHAIN_SLICE_BATCH, end_height + 1)
        page = api_get(
            node_base,
            "/blocks/chainSlice",
            params={"fromHeight": first - 1, "toHeight": after_last - 1},
            timeout=8
        )

        if not isinstance(page, list):
            raise ValueError(
                f"Ergo chainSlice returned a non-list response "
                f"for heights {first}..{after_last - 1}"
            )

        batch = [
            h for h in page
            if isinstance(h, dict)
            and first <= integer(h.get("height")) < after_last
        ]
        batch.sort(key=lambda h: integer(h.get("height")))

        # Length alone is insufficient: duplicate heights can conceal gaps.
        heights = [integer(h.get("height")) for h in batch]
        if heights != list(range(first, after_last)):
            raise ValueError(
                f"Ergo chainSlice has missing or duplicate canonical headers "
                f"for heights {first}..{after_last - 1}"
            )

        headers.extend(batch)

    return headers


def transaction_is_lithos_genesis(tx, holding_tree):
    if not isinstance(tx, dict):
        return False

    inputs = tx.get("inputs") or []
    outputs = tx.get("outputs") or []

    if not inputs or not outputs:
        return False

    if not isinstance(inputs[0], dict) or not isinstance(outputs[0], dict):
        return False

    out0 = outputs[0]

    # Every Lithos genesis creates its Holding output at output zero.
    if safe_text(out0.get("ergoTree", "")) != holding_tree:
        return False

    assets = out0.get("assets") or []
    if not assets or not isinstance(assets[0], dict):
        return False

    # The rollup NFT is minted from input zero's collateral box ID.
    token_id = safe_text(assets[0].get("tokenId", ""))
    input_id = safe_text(inputs[0].get("boxId", ""))

    return bool(token_id and input_id and token_id == input_id)


def classify_ergo_block(node_base, header, holding_tree):
    block_id = safe_text(header.get("id", "")).strip()
    if not block_id:
        raise ValueError("canonical Ergo header is missing its block id")

    block_txs = api_get(
        node_base,
        "/blocks/"
        + urllib.parse.quote(block_id, safe="")
        + "/transactions",
        timeout=15,
        # Ergo returns the entire block's transactions in one unpaged reply.
        # Only this endpoint gets an elevated limit; all other APIs stay 2 MiB.
        max_response_bytes=MAX_BLOCK_TX_RESPONSE_BYTES
    )

    transactions = block_txs.get("transactions") or []
    is_lithos = any(
        transaction_is_lithos_genesis(tx, holding_tree)
        for tx in transactions
    )

    lender_pk = ""
    if is_lithos:
        pow_solutions = header.get("powSolutions") or {}
        lender_pk = safe_text(pow_solutions.get("pk", "")).strip()

    return {
        "blockId": block_id,
        "lithos": bool(is_lithos),
        "lenderPk": lender_pk,
    }


def network_hashrate_from_difficulty(doc):
    current = (doc or {}).get("current") or {}
    hps = dec(current.get("hashesPerSecond"))

    if hps > 0:
        return hps

    epochs = (doc or {}).get("epochs") or []
    if isinstance(epochs, list):
        for epoch in reversed(epochs):
            if not isinstance(epoch, dict):
                continue
            hps = dec(epoch.get("hashesPerSecond"))
            if hps > 0:
                return hps

    return Decimal(0)


def fmt_hashrate(hps):
    value = dec(hps)

    units = (
        (Decimal("1000000000000000"), "PH/s"),
        (Decimal("1000000000000"), "TH/s"),
        (Decimal("1000000000"), "GH/s"),
        (Decimal("1000000"), "MH/s"),
        (Decimal("1000"), "KH/s"),
    )

    for scale, name in units:
        if value >= scale:
            return f"{value / scale:,.2f} {name}"

    return f"{value:,.0f} H/s"


def summarize_adoption(state, network_hps):
    tip = integer(state.get("lastTip"))
    records = state.get("records") or {}

    result = {
        "tip": tip,
        "networkHashrate": network_hps,
        "windows": {},
    }

    for window in ADOPTION_WINDOWS:
        first = tip - window + 1

        selected = []
        for height_s, record in records.items():
            height = integer(height_s)
            if first <= height <= tip and isinstance(record, dict):
                selected.append(record)

        scanned = len(selected)
        lithos = sum(
            1 for record in selected
            if bool(record.get("lithos"))
        )

        lender_keys = {
            safe_text(record.get("lenderPk", ""))
            for record in selected
            if bool(record.get("lithos"))
            and safe_text(record.get("lenderPk", ""))
        }

        share = (
            Decimal(lithos) / Decimal(scanned)
            if scanned else Decimal(0)
        )

        result["windows"][window] = {
            "scanned": scanned,
            "lithos": lithos,
            "share": share,
            "impliedHashrate": network_hps * share,
            "uniqueLenders": len(lender_keys),
            "complete": scanned == window,
        }

    return result


def update_network_adoption(
    node_base,
    stats_doc,
    difficulty_doc,
    state_file
):
    """
    Maintain a canonical rolling 1,000-block classifier.

    First run fetches transaction contents for the entire window. Later runs
    fetch the 1,000 lightweight headers to verify canonicality, but transaction
    contents are fetched only for new or reorged block IDs.
    """
    state = load_adoption_state(state_file)

    holding_tree = discover_holding_tree(
        node_base,
        stats_doc,
        state
    )

    old_tree = safe_text(state.get("holdingErgoTree") or "")
    if old_tree and old_tree != holding_tree:
        # A protocol contract change invalidates classifications made against
        # the previous Holding ErgoTree.
        state["records"] = {}
        state["lastTip"] = None

    state["holdingErgoTree"] = holding_tree

    info = api_get(node_base, "/info", timeout=8)
    tip = integer(info.get("fullHeight"))

    if tip <= 0:
        raise ValueError("Ergo node did not report a usable fullHeight")

    records = state.setdefault("records", {})

    # Nothing on-chain has changed since the previous dashboard refresh.
    if integer(state.get("lastTip")) == tip and records:
        return summarize_adoption(
            state,
            network_hashrate_from_difficulty(difficulty_doc)
        )

    start = max(1, tip - ADOPTION_MAX_BLOCKS + 1)
    headers = fetch_chain_headers(node_base, start, tip)

    canonical_heights = set()

    for header in headers:
        if not isinstance(header, dict):
            continue

        height = integer(header.get("height"))
        block_id = safe_text(header.get("id", "")).strip()

        if height <= 0 or not block_id:
            continue

        canonical_heights.add(height)

        old = records.get(str(height))
        if (
            isinstance(old, dict)
            and safe_text(old.get("blockId", "")) == block_id
        ):
            continue

        records[str(height)] = classify_ergo_block(
            node_base,
            header,
            holding_tree
        )

    # Remove anything outside the rolling window or displaced by a reorg.
    for height_s in list(records):
        height = integer(height_s)
        if (
            height < start
            or height > tip
            or height not in canonical_heights
        ):
            records.pop(height_s, None)

    state["lastTip"] = tip
    save_adoption_state(state_file, state)

    return summarize_adoption(
        state,
        network_hashrate_from_difficulty(difficulty_doc)
    )


