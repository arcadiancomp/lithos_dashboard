def render_commitment(c):
    state = str(c.get("state", "unknown"))
    height = integer(c.get("height"))
    config_diff = c.get("configDiff", "-")
    can_commit = c.get("canCommit", False)
    blocked = c.get("blockedReason")

    if state == "active":
        state_badge = badge("ACTIVE", "good")
    elif state in ("waiting", "registering"):
        state_badge = badge(state.upper(), "warn")
    else:
        state_badge = badge(state.upper(), "bad")

    kv("Commitment state", state_badge)
    kv("Chain height", col(f"{height:,}", BOLD, WHITE))
    kv("Configured difficulty", col(config_diff, BOLD, CYAN))

    inflight = c.get("inFlight")
    pending = c.get("pending")
    inforce = c.get("inForce")

    if inforce:
        kv(
            "In-force difficulty",
            col(inforce.get("diff", "-"), BOLD, GREEN)
        )

    if pending:
        served = integer(pending.get("servedFromHeight"))
        force = integer(pending.get("inForceFromHeight"))

        kv(
            "Pending difficulty",
            col(pending.get("diff", "-"), BOLD, YELLOW)
        )

        if served:
            remain = max(0, served - height)
            color = GREEN if remain == 0 else YELLOW
            kv(
                "Stratum serves in",
                col(f"{remain:,} blocks  @ {served:,}", color)
            )

        if force:
            remain = max(0, force - height)
            color = GREEN if remain == 0 else YELLOW
            kv(
                "In force in",
                col(f"{remain:,} blocks  @ {force:,}", color)
            )

    if inflight:
        kv("In-flight commitment", col(str(inflight), YELLOW))

    replaceable = integer(c.get("replaceableFromHeight"))
    if replaceable:
        remaining = max(0, replaceable - height)
        kv(
            "Next change allowed",
            f"{remaining:,} blocks  @ {replaceable:,}"
        )

    if not can_commit and blocked:
        kv("Commit control", col(blocked, YELLOW))


def render_workers(w, nisp_history, opportunity_estimate):
    accepted = integer(w.get("acceptedShares"))
    rejected = integer(w.get("rejectedShares"))
    supers = integer(w.get("superShares"))
    sph = dec(w.get("superSharesPerHour"))
    candidates = integer(w.get("blockCandidates"))

    nisp = w.get("nisp") or {}
    held = bool(nisp.get("held"))
    nisp_count = integer(nisp.get("superSharesInWindow"))
    required = integer(nisp.get("required"), 10)
    blocks_remaining = nisp.get("blocksRemaining")
    valid_through = nisp.get("validThroughHeight")

    if rejected == 0:
        share_text = (
            col(f"{accepted:,} accepted", GREEN, BOLD)
            + " / "
            + col("0 rejected", GREEN)
        )
    else:
        share_text = (
            col(f"{accepted:,} accepted", GREEN)
            + " / "
            + col(f"{rejected:,} rejected", RED, BOLD)
        )

    kv("Shares this session", share_text)
    kv("Super shares", col(f"{supers:,}", BOLD, CYAN))
    kv("Super shares / hour", col(fmt_rate(sph), BOLD, CYAN))

    if candidates:
        kv("Block candidates", col(f"{candidates:,}", MAGENTA))

    if held:
        nisp_text = badge("NISP HELD", "good")
    else:
        nisp_text = badge("NISP NOT HELD", "bad")

    nisp_text += f"   {nisp_count}/{required}"
    kv("NISP status", nisp_text)

    if blocks_remaining is not None:
        color = GREEN if integer(blocks_remaining) >= 15 else YELLOW
        kv(
            "NISP coverage",
            col(
                f"{integer(blocks_remaining)} blocks remaining"
                + (
                    f"  through {integer(valid_through):,}"
                    if valid_through else ""
                ),
                color
            )
        )

    print()
    render_nisp_history(nisp_history, opportunity_estimate)


