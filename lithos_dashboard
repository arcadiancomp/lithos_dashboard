def fetch_buckets(base, days):
    now = datetime.now(timezone.utc)

    today = datetime(
        now.year, now.month, now.day,
        tzinfo=timezone.utc
    )

    start = today - timedelta(days=max(1, days - 1))
    end = today + timedelta(days=1)

    params = {
        "from": int(start.timestamp() * 1000),
        "until": int(end.timestamp() * 1000),
        "interval": "day",
    }

    try:
        return api_get(
            base,
            "/stats/mining/buckets",
            params=params
        )
    except Exception:
        # Conservative fallback: complete days only.
        params["until"] = int(today.timestamp() * 1000)
        return api_get(
            base,
            "/stats/mining/buckets",
            params=params
        )


def render(
    base,
    node_base,
    days,
    refresh,
    nisp_state_file,
    adoption_state_file,
    adoption_enabled
):
    commitment = api_get(base, "/mining/commitment")
    workers = api_get(base, "/stats/mining/workers")

    try:
        stats_doc = api_get(base, "/stats")
    except Exception:
        # /stats is used only for exact rollup-height correlation. Keep the
        # dashboard useful if an older client lacks it or it is temporarily busy.
        stats_doc = {}

    totals_doc = api_get(base, "/stats/mining/totals")
    bucket_doc = fetch_buckets(base, days)

    try:
        payment_ledger = api_get(base, "/stats/mining/payments",
                                 params={"limit": 500})
    except Exception as exc:
        payment_ledger = {"error": safe_text(exc)}

    try:
        difficulty_doc = api_get(base, "/stats/mining/difficulty")
    except Exception:
        difficulty_doc = {}

    if adoption_enabled:
        try:
            adoption = update_network_adoption(
                node_base,
                stats_doc,
                difficulty_doc,
                adoption_state_file
            )
        except Exception as exc:
            adoption = {"error": safe_text(exc)}
    else:
        adoption = {
            "error": "disabled with --no-adoption"
        }

    totals = totals_doc.get("totals") or {}
    nisp_history = update_nisp_history(
        nisp_state_file,
        workers,
        stats_doc=stats_doc
    )
    opportunity_estimate = estimate_missed_reward(
        nisp_history,
        totals,
        commitment
    )
    econ = economics(totals)

    from_ts = integer(totals_doc.get("fromTimestamp"))
    observed = integer(totals_doc.get("observedAt"))

    span_days = 0.0
    if from_ts and observed and observed > from_ts:
        span_days = (observed - from_ts) / 86400000.0

    source_height = integer(totals_doc.get("sourceHeight"))
    target_height = integer(totals_doc.get("targetHeight"))

    print(CLEAR_HOME, end="")

    now_local = datetime.now().astimezone()

    print(
        col(f" LITHOS MINING + SEQUENCER DASHBOARD v{VERSION} ", BOLD, WHITE, BLUE)
        + "   "
        + col(now_local.strftime("%Y-%m-%d %H:%M:%S %Z"), BOLD)
    )

    print(
        col(" API ", DIM)
        + f" {base}"
        + col("   │   refresh ", DIM)
        + f"{refresh}s"
        + col("   │   source height ", DIM)
        + f"{source_height:,}"
    )

    income_model = calculate_monthly_income(
        totals, payment_ledger, span_days
    )

    if target_height and target_height != source_height:
        print(
            col(
                f" Stats collector lag: {target_height - source_height} block(s)",
                YELLOW
            )
        )

    terminal_columns = shutil.get_terminal_size((150, 40)).columns

    if terminal_columns >= WIDE_LAYOUT_MIN_COLUMNS:
        render_wide_overview(
            commitment,
            workers,
            nisp_history,
            opportunity_estimate,
            adoption,
            econ,
            span_days
        )
    else:
        section("MINER STATE")
        render_commitment(commitment)

        section("CURRENT SHARE SESSION")
        render_workers(workers, nisp_history, opportunity_estimate)

        section("NETWORK ADOPTION")
        render_network_adoption(adoption)

        section("POOL / NETWORK ECONOMICS")
        print(
            col(
                "  These figures describe the Lithos network/pool retained history, "
                "not all of them are your personal income.",
                YELLOW
            )
        )
        print()
        render_economics(econ, span_days)

    render_income_projection(
        income_model, terminal_columns >= WIDE_LAYOUT_MIN_COLUMNS
    )

    section(f"DAILY HISTORY — LAST {days} UTC DAYS")
    render_daily(bucket_doc.get("buckets") or [])

    print()
    print(hr())
    print(
        "  "
        + col("Green", GREEN, BOLD)
        + " = healthy / revenue   "
        + col("Yellow", YELLOW, BOLD)
        + " = pending / caution   "
        + col("Red", RED, BOLD)
        + " = problem   "
        + col("Magenta", MAGENTA, BOLD)
        + " = candidate revenue not identified as pool DEX"
    )

    if bucket_doc.get("partial"):
        print(
            col(
                "  Daily range is partial because retained history does not cover the entire requested window.",
                DIM
            )
        )

    print(
        col(
            "  Ctrl-C exits. Values update in place.",
            DIM
        )
    )


def main():
    global USE_COLOR

    parser = argparse.ArgumentParser(
        description="Lithos mining/sequencer terminal dashboard"
    )

    parser.add_argument(
        "--url",
        default="http://127.0.0.1:9000",
        help="Lithos HTTP(S) API base URL"
    )

    parser.add_argument(
        "--node-url",
        default="http://127.0.0.1:9053",
        help="Ergo node HTTP(S) API base URL used for adoption scanning"
    )

    parser.add_argument(
        "--no-adoption",
        action="store_true",
        help="Disable Ergo-chain Lithos adoption scanning"
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}"
    )

    parser.add_argument(
        "--interval",
        type=int,
        default=15,
        help="Refresh interval in seconds (default: 15)"
    )

    parser.add_argument(
        "--days",
        type=int,
        default=7,
        help="Daily history window (default: 7)"
    )

    parser.add_argument(
        "--state-file",
        default=None,
        help="Persistent NISP history file (default: XDG state directory)"
    )

    parser.add_argument(
        "--reset-nisp-history",
        action="store_true",
        help="Reset persistent NISP lapse history before starting"
    )

    parser.add_argument(
        "--adoption-state-file",
        default=None,
        help="Persistent network-adoption cache (default: XDG state directory)"
    )

    parser.add_argument(
        "--reset-adoption-history",
        action="store_true",
        help="Discard cached Ergo block classifications before starting"
    )

    parser.add_argument(
        "--once",
        action="store_true",
        help="Render once and exit"
    )

    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI colors"
    )

    args = parser.parse_args()

    USE_COLOR = (
        not args.no_color
        and sys.stdout.isatty()
        and "NO_COLOR" not in os.environ
    )

    interval = max(1, args.interval)
    days = max(1, min(args.days, 30))
    base_url = normalize_base_url(args.url)
    node_base_url = normalize_base_url(args.node_url)
    nisp_state_file = args.state_file or default_nisp_state_file()
    adoption_state_file = (
        args.adoption_state_file
        or default_adoption_state_file()
    )

    if args.reset_nisp_history:
        try:
            os.remove(nisp_state_file)
        except FileNotFoundError:
            pass

    if args.reset_adoption_history:
        try:
            os.remove(adoption_state_file)
        except FileNotFoundError:
            pass

    if USE_COLOR:
        print(HIDE_CURSOR, end="", flush=True)

    try:
        while True:
            try:
                render(
                    base_url,
                    node_base_url,
                    days,
                    interval,
                    nisp_state_file,
                    adoption_state_file,
                    not args.no_adoption
                )

            except Exception as exc:
                print(CLEAR_HOME, end="")
                print(
                    col(
                        " LITHOS DASHBOARD ERROR ",
                        BOLD,
                        WHITE,
                        BG_RED
                    )
                )
                print()
                print(f"  {type(exc).__name__}: {safe_text(exc)}")
                print()
                print(
                    col(
                        f"  Retrying in {interval} seconds...",
                        YELLOW
                    )
                )

            if args.once:
                break

            time.sleep(interval)

    except KeyboardInterrupt:
        pass

    finally:
        if USE_COLOR:
            print(SHOW_CURSOR, end="", flush=True)
        print()


if __name__ == "__main__":
    main()
