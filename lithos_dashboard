        compact_kv("LIT / 30d", col(shown(model["litMonth"], "LIT", 1), BOLD, CYAN)),
        compact_kv("Claims / 30d", f"~{model['claimsPerMonth']:.1f}"),
        compact_kv("Model confidence", col(model["confidence"], YELLOW)),
    ]
    right = [
