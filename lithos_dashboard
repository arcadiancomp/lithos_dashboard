# ─────────────────────────────────────────────────────────────────────────────
# ANSI
# ─────────────────────────────────────────────────────────────────────────────

RESET   = "\033[0m"
BOLD    = "\033[1m"
DIM     = "\033[2m"

RED     = "\033[31m"
GREEN   = "\033[32m"
YELLOW  = "\033[33m"
BLUE    = "\033[34m"
MAGENTA = "\033[35m"
CYAN    = "\033[36m"
WHITE   = "\033[37m"

BG_GREEN  = "\033[42m"
BG_YELLOW = "\033[43m"
BG_RED    = "\033[41m"

CLEAR_HOME = "\033[2J\033[H"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

USE_COLOR = True

VERSION = "0.1.4"
MAX_RESPONSE_BYTES = 2 * 1024 * 1024


def safe_text(value):
    """Strip terminal control characters from untrusted text."""
    text = str(value)
    return "".join(
        ch for ch in text
        if ch == "\t" or 32 <= ord(ch) < 127 or ord(ch) >= 160
    )


def sanitize_json(value):
    """Recursively sanitize string values returned by an HTTP API."""
    if isinstance(value, str):
        return safe_text(value)
    if isinstance(value, list):
        return [sanitize_json(v) for v in value]
    if isinstance(value, dict):
        return {k: sanitize_json(v) for k, v in value.items()}
    return value


def normalize_base_url(base):
    base = safe_text(base).strip()
    parsed = urllib.parse.urlsplit(base)

    if parsed.scheme not in ("http", "https"):
        raise ValueError("API URL must use http:// or https://")

    if not parsed.hostname:
        raise ValueError("API URL must include a hostname")

    if parsed.username is not None or parsed.password is not None:
        raise ValueError("API URL must not contain embedded credentials")

    if parsed.query or parsed.fragment:
        raise ValueError("API base URL must not contain a query string or fragment")

    return base.rstrip("/")


def col(text, *codes):
    text = str(text)
    if not USE_COLOR:
        return text
    return "".join(codes) + text + RESET


def badge(text, state="neutral"):
    if state == "good":
        return col(f" {text} ", BOLD, BG_GREEN, "\033[30m")
    if state == "warn":
        return col(f" {text} ", BOLD, BG_YELLOW, "\033[30m")
    if state == "bad":
        return col(f" {text} ", BOLD, BG_RED, WHITE)
    return col(f" {text} ", BOLD, BLUE)


# ─────────────────────────────────────────────────────────────────────────────
# Data helpers
# ─────────────────────────────────────────────────────────────────────────────

NANO = Decimal("1000000000")


def dec(v, default="0"):
    try:
        if v is None:
            return Decimal(default)
        return Decimal(str(v))
    except (InvalidOperation, ValueError, TypeError):
        return Decimal(default)


def integer(v, default=0):
    try:
        return int(v)
    except (ValueError, TypeError):
        return default


def erg(totals, key):
    return dec(totals.get(key, "0")) / NANO


def num(totals, key):
    return integer(totals.get(key, "0"))


def fmt_erg(v, places=3):
    v = dec(v)
    if abs(v) >= Decimal("1000"):
        return f"{v:,.1f}"
    return f"{v:,.{places}f}"


def fmt_rate(v):
    v = dec(v)
    return f"{v:,.2f}"


def fmt_pct(v):
    return f"{float(v):+.1f}%"


def api_get(base, path, params=None, timeout=4):
    base = normalize_base_url(base)
    url = base + path

    if params:
        url += "?" + urllib.parse.urlencode(params)

    req = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": f"LithosDashboard/{VERSION}",
        }
    )

    with urllib.request.urlopen(req, timeout=timeout) as response:
        content_length = response.headers.get("Content-Length")
        if content_length:
            try:
                declared = int(content_length)
            except ValueError:
                declared = 0
            if declared > MAX_RESPONSE_BYTES:
                raise ValueError(
                    f"API response exceeds {MAX_RESPONSE_BYTES} bytes"
                )

        raw = response.read(MAX_RESPONSE_BYTES + 1)

    if len(raw) > MAX_RESPONSE_BYTES:
        raise ValueError(
            f"API response exceeds {MAX_RESPONSE_BYTES} bytes"
        )

    return sanitize_json(json.loads(raw.decode("utf-8")))


def ms_date(ms):
    if not ms:
        return "-"
    return datetime.fromtimestamp(
        int(ms) / 1000,
        tz=timezone.utc
    ).strftime("%Y-%m-%d")


def ms_datetime(ms):
    if not ms:
        return "-"
    return datetime.fromtimestamp(
        int(ms) / 1000,
        tz=timezone.utc
    ).strftime("%Y-%m-%d %H:%M:%S UTC")


def hr(char="─"):
    width = shutil.get_terminal_size((150, 40)).columns
    width = max(90, min(width, 180))
    return col(char * width, DIM)


def section(title):
    print()
    print(col(f"  {title}", BOLD, CYAN))
    print(hr())


def kv(label, value, label_width=28):
    print(
        "  "
        + col(f"{label:<{label_width}}", DIM)
        + str(value)
    )


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def visible_len(value):
    return len(ANSI_RE.sub("", str(value)))


def pad_ansi(value, width):
    value = str(value)
    return value + (" " * max(0, width - visible_len(value)))


def compact_kv(label, value, label_width=23):
    return (
        "  "
        + col(f"{label:<{label_width}}", DIM)
        + str(value)
    )


def print_columns(left_title, left_lines, right_title, right_lines):
    # ANSI-aware side-by-side panels for wide, low-height terminals.
    terminal_width = shutil.get_terminal_size((150, 40)).columns
    total_width = max(120, min(terminal_width, 180))
    gap = 4
    panel_width = (total_width - gap) // 2

    left_heading = col(f"  {left_title}", BOLD, CYAN)
    right_heading = col(f"  {right_title}", BOLD, CYAN)

    print()
    print(
        pad_ansi(left_heading, panel_width)
        + (" " * gap)
        + right_heading
    )
    print(
        col("─" * panel_width, DIM)
        + (" " * gap)
        + col("─" * panel_width, DIM)
    )

    rows = max(len(left_lines), len(right_lines))
    for i in range(rows):
        left = left_lines[i] if i < len(left_lines) else ""
        right = right_lines[i] if i < len(right_lines) else ""
        print(
            pad_ansi(left, panel_width)
            + (" " * gap)
            + right
        )


# ─────────────────────────────────────────────────────────────────────────────
# Persistent NISP reliability and opportunity tracking
# ─────────────────────────────────────────────────────────────────────────────

MAX_TRACKED_NISP_HEIGHTS = 4096
MAX_CLASSIFIED_ROLLUPS = 512


def default_nisp_state_file():
    root = os.environ.get("XDG_STATE_HOME")
    if not root:
        root = os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(root, "lithos_dashboard", "nisp_history.json")


def empty_nisp_history():
    return {
        "version": 2,
        "trackingStartedAt": None,
        "trackingStartedHeight": None,
        "lastObservedAt": None,
        "lastHeight": None,
        "lastHeld": None,
        "observedHeights": 0,
        "lapseEvents": 0,
        "lapseHeights": 0,
        "lastLapseHeight": None,
        "lastRecoveryHeight": None,
        "lastLapseCountedHeight": None,
        "currentLapseHeights": 0,
        "longestLapseHeights": 0,
        "heightStates": {},
        "opportunityTrackingStartedHeight": None,
        "classifiedRollups": {},
        "rollupsObservedWithNispStatus": 0,
        "rollupsEligible": 0,
        "rollupsMissed": 0,
        "missedRollupInitialNanoErg": "0",
        "lastMissedRollupHeight": None,
    }


def load_nisp_history(path):
    state = empty_nisp_history()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            saved = json.load(fh)

        if isinstance(saved, dict) and saved.get("version") in (1, 2):
            # Version 1 did not preserve per-height states. Its aggregate lapse
            # counters remain useful, while rollup opportunity accounting starts
            # from the first v2 observation.
            state.update(saved)
            state["version"] = 2

            if not isinstance(state.get("heightStates"), dict):
                state["heightStates"] = {}
            if not isinstance(state.get("classifiedRollups"), dict):
                state["classifiedRollups"] = {}

    except FileNotFoundError:
        pass
    except (OSError, ValueError, TypeError):
        # A damaged state file must never stop the dashboard.
        pass

    return state


def save_nisp_history(path, state):
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)

    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
        fh.write("\n")

    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def remember_height_state(state, height, held):
    states = state.setdefault("heightStates", {})
    states[str(height)] = bool(held)

    if len(states) > MAX_TRACKED_NISP_HEIGHTS:
        ordered = sorted(states, key=lambda h: integer(h))
        for old in ordered[:-MAX_TRACKED_NISP_HEIGHTS]:
            states.pop(old, None)


def classify_rollup_opportunities(state, stats_doc):
    """
    Correlate exact confirmed Lithos genesis heights from /stats with the
    NISP state we actually observed at those same rollup-start heights.

    This intentionally does not guess across dashboard downtime. A rollup is
    classified only when its exact height exists in heightStates.
    """
    mining = (stats_doc or {}).get("mining") or {}
    blocks = mining.get("blocks") or []

    if not isinstance(blocks, list):
        return

    states = state.setdefault("heightStates", {})
    classified = state.setdefault("classifiedRollups", {})

    current_keys = set()
    for block in blocks:
        if not isinstance(block, dict):
            continue
        txid = safe_text(block.get("transactionId", ""))
        block_id = safe_text(block.get("blockId", ""))
        holding_id = safe_text(block.get("holdingBoxId", ""))
        height = integer(block.get("height"))
        key = txid or holding_id or f"{block_id}:{height}"
        if key:
            current_keys.add(key)

    # /stats returns every recent Lithos record unless its documented 50-record
    # cap is hit. When the list is complete, remove a previously classified
    # record that disappeared inside the current recent range after a reorg.
    if len(blocks) < 50:
        recent_from = integer(mining.get("recentFromHeight"))
        source_height = integer(mining.get("sourceHeight"))
        for key, record in list(classified.items()):
            height = integer((record or {}).get("height"))
            if (
                recent_from > 0
                and source_height >= recent_from
                and recent_from <= height <= source_height
                and key not in current_keys
            ):
                state["rollupsObservedWithNispStatus"] = max(
                    0,
                    integer(state.get("rollupsObservedWithNispStatus")) - 1
                )
                if bool((record or {}).get("held")):
                    state["rollupsEligible"] = max(
                        0,
                        integer(state.get("rollupsEligible")) - 1
                    )
                else:
                    state["rollupsMissed"] = max(
                        0,
                        integer(state.get("rollupsMissed")) - 1
                    )
                    state["missedRollupInitialNanoErg"] = str(
                        max(
                            0,
                            integer(state.get("missedRollupInitialNanoErg"))
                            - integer((record or {}).get("initialHoldingNanoErg"))
                        )
                    )
                classified.pop(key, None)

    for block in blocks:
        if not isinstance(block, dict):
            continue

        height = integer(block.get("height"))
        if height <= 0 or str(height) not in states:
            continue

        txid = safe_text(block.get("transactionId", ""))
        block_id = safe_text(block.get("blockId", ""))
        holding_id = safe_text(block.get("holdingBoxId", ""))

        # transactionId is canonical for one genesis. Fall back to the holding
        # id or block/height only if an older client omitted it.
        key = txid or holding_id or f"{block_id}:{height}"
        if not key or key in classified:
            continue

        held = bool(states[str(height)])
        initial = max(0, integer(block.get("initialHoldingNanoErg")))

        classified[key] = {
            "height": height,
            "held": held,
            "initialHoldingNanoErg": str(initial),
            "blockId": block_id,
        }

        state["rollupsObservedWithNispStatus"] = (
            integer(state.get("rollupsObservedWithNispStatus")) + 1
        )

        if held:
            state["rollupsEligible"] = integer(state.get("rollupsEligible")) + 1
        else:
            state["rollupsMissed"] = integer(state.get("rollupsMissed")) + 1
            state["missedRollupInitialNanoErg"] = str(
                integer(state.get("missedRollupInitialNanoErg")) + initial
            )
            state["lastMissedRollupHeight"] = height

    # We only need IDs long enough to outlive /stats' recent-block window.
    # Totals above remain cumulative after old IDs are discarded.
    if len(classified) > MAX_CLASSIFIED_ROLLUPS:
        ordered = sorted(
            classified.items(),
            key=lambda item: integer((item[1] or {}).get("height"))
        )
        for key, _ in ordered[:-MAX_CLASSIFIED_ROLLUPS]:
            classified.pop(key, None)


def update_nisp_history(path, workers, stats_doc=None):
    state = load_nisp_history(path)
    nisp = workers.get("nisp") or {}

    height = integer(nisp.get("atHeight"))
    if height > 0:
        held = bool(nisp.get("held"))
        now_ms = integer(
            workers.get("observedAt"),
            int(time.time() * 1000)
        )

        last_height = state.get("lastHeight")
        last_held = state.get("lastHeld")

        if state.get("trackingStartedHeight") is None:
            state["trackingStartedHeight"] = height
            state["trackingStartedAt"] = now_ms
            state["observedHeights"] = 1
        elif last_height is not None and height > integer(last_height):
            # Count unique forward-moving heights. If polling skipped a height,
            # do not guess whether that unseen height was held or unheld.
            state["observedHeights"] = (
                integer(state.get("observedHeights")) + 1
            )

        entered_lapse = (
            not held
            and (last_held is None or bool(last_held))
        )

        if entered_lapse:
            state["lapseEvents"] = integer(state.get("lapseEvents")) + 1
            state["lastLapseHeight"] = height

        if not held:
            # Count each height at most once even when polled repeatedly.
            if state.get("lastLapseCountedHeight") != height:
                state["lapseHeights"] = integer(state.get("lapseHeights")) + 1
                state["lastLapseCountedHeight"] = height

                if (
                    last_height is not None
                    and integer(last_height) == height - 1
                    and last_held is False
                ):
                    state["currentLapseHeights"] = (
                        integer(state.get("currentLapseHeights")) + 1
                    )
                else:
                    state["currentLapseHeights"] = 1

                state["longestLapseHeights"] = max(
                    integer(state.get("longestLapseHeights")),
                    integer(state.get("currentLapseHeights")),
                )
        else:
            if last_held is False:
                state["lastRecoveryHeight"] = height
            state["currentLapseHeights"] = 0

        remember_height_state(state, height, held)

        if state.get("opportunityTrackingStartedHeight") is None:
            state["opportunityTrackingStartedHeight"] = height

        # Do not move the persistent cursor backwards across a short reorg.
        if last_height is None or height >= integer(last_height):
            state["lastHeight"] = height
            state["lastHeld"] = held

        state["lastObservedAt"] = now_ms

    classify_rollup_opportunities(state, stats_doc)
    save_nisp_history(path, state)
    return state


def estimate_missed_reward(state, totals, commitment):
    """
    Roughly value missed rollups using the retained mature-rollup average.

    payoutReady.valueNanoErg is the whole rollup's ERG reward and
    payoutReady.claimedScore is its total payout score. For a rollup we missed,
    model our hypothetical share as ownScore / (averageExistingScore + ownScore).

    This is deliberately an estimate: the missed rollup's eventual score and
    final top-ups are not known at genesis time.
    """
    missed = integer(state.get("rollupsMissed"))
    if missed <= 0:
        return None

    payout_count = num(totals, "rollup.payoutReady.count")
    total_reward = erg(totals, "rollup.payoutReady.valueNanoErg")
    total_score = dec(totals.get("rollup.payoutReady.claimedScore", "0"))

    in_force = commitment.get("inForce") or {}
    own_score = dec(in_force.get("score", "0"))

    if (
        payout_count <= 0
        or total_reward <= 0
        or total_score <= 0
        or own_score <= 0
    ):
        return None

    avg_reward = total_reward / Decimal(payout_count)
    avg_existing_score = total_score / Decimal(payout_count)
    share = own_score / (avg_existing_score + own_score)
    estimated = Decimal(missed) * avg_reward * share

    return {
        "erg": estimated,
        "sharePct": share * Decimal(100),
        "sampleRollups": payout_count,
        "avgReward": avg_reward,
    }


def render_nisp_history(state, opportunity_estimate=None):
    observed = integer(state.get("observedHeights"))
    lapse_heights = integer(state.get("lapseHeights"))
    events = integer(state.get("lapseEvents"))
    current = integer(state.get("currentLapseHeights"))
    longest = integer(state.get("longestLapseHeights"))

    availability = (
        100.0 * max(0, observed - lapse_heights) / observed
        if observed else 100.0
    )

    if availability >= 95.0:
        availability_color = GREEN
    elif availability >= 85.0:
        availability_color = YELLOW
    else:
        availability_color = RED

    kv(
        "NISP availability",
        col(f"{availability:.2f}%", BOLD, availability_color)
        + f"  ({max(0, observed - lapse_heights):,}/{observed:,} observed heights)"
    )

    kv(
        "NISP lapse events",
        col(f"{events:,}", GREEN if events == 0 else YELLOW)
    )

    kv(
        "Heights with lapse",
        col(
            f"{lapse_heights:,} / {observed:,} observed",
            GREEN if lapse_heights == 0 else YELLOW
        )
    )

    if current:
        kv(
            "Current lapse",
            col(f"{current:,} observed height(s)", RED, BOLD)
        )

    kv(
        "Longest lapse",
        col(
            f"{longest:,} observed height(s)",
            GREEN if longest == 0 else YELLOW
        )
    )

    started = state.get("trackingStartedHeight")
    if started:
        kv("NISP tracking since", f"height {integer(started):,}")

    last_lapse = state.get("lastLapseHeight")
    if last_lapse:
        kv("Last lapse observed", f"height {integer(last_lapse):,}")

    rollups = integer(state.get("rollupsObservedWithNispStatus"))
    eligible = integer(state.get("rollupsEligible"))
    missed = integer(state.get("rollupsMissed"))

    print()

    kv(
        "Rollups with NISP sample",
        f"{rollups:,}  ({eligible:,} eligible / {missed:,} unheld)"
    )

    kv(
        "Rollups while unheld",
        col(
            f"{missed:,}",
            GREEN if missed == 0 else RED,
            BOLD if missed else GREEN
        )
    )

    missed_initial = (
        Decimal(integer(state.get("missedRollupInitialNanoErg"))) / NANO
    )
    kv(
        "Missed initial pool value",
        col(
            f"{fmt_erg(missed_initial)} ERG",
            GREEN if missed == 0 else YELLOW
        )
        + col("  (pool value, not personal loss)", DIM)
    )

    if opportunity_estimate is not None:
        kv(
            "Est. miner reward missed",
            col(
                f"{fmt_erg(opportunity_estimate['erg'])} ERG",
                RED if missed else GREEN,
                BOLD
            )
        )
        kv(
            "Opportunity model",
            col(
                f"{float(opportunity_estimate['sharePct']):.1f}% modeled share; "
                f"{opportunity_estimate['sampleRollups']} mature rollup sample",
                DIM
            )
        )

    opportunity_start = state.get("opportunityTrackingStartedHeight")
    if opportunity_start:
        kv(
            "Opportunity tracking",
            f"since height {integer(opportunity_start):,}"
        )


