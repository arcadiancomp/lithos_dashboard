def economics(t):
    lithos_blocks = num(t, "lithos.blocks")
    chain_blocks = num(t, "chain.blocks")

    genesis = erg(t, "holding.genesisNanoErg")
    topup = erg(t, "rollup.topUp.valueNanoErg")
    priority = erg(t, "lithos.priorityFeeNanoErg")

    payout_reward = erg(t, "network.payout.rewardNanoErg")
    payout_gross = erg(t, "network.payout.grossNanoErg")

    dex_lithos_gross = erg(t, "batching.lithosdex.grossNanoErg")
    dex_ergo_gross = erg(t, "batching.ergodex.grossNanoErg")
    dex_gross = dex_lithos_gross + dex_ergo_gross

    dex_lithos_net = erg(t, "batching.lithosdex.afterTransactionFeesNanoErg")
    dex_ergo_net = erg(t, "batching.ergodex.afterTransactionFeesNanoErg")
    dex_net = dex_lithos_net + dex_ergo_net

    pool_dex = (
        erg(t, "pool.batching.lithosdex.grossNanoErg")
        + erg(t, "pool.batching.ergodex.grossNanoErg")
    )

    local_dex_net = (
        erg(t, "local.batching.lithosdex.afterTransactionFeesNanoErg")
        + erg(t, "local.batching.ergodex.afterTransactionFeesNanoErg")
    )

    local_payout = erg(t, "local.payout.rewardNanoErg")

    other_topup = max(Decimal(0), topup - pool_dex)

    initial_per_block = (
        genesis / lithos_blocks
        if lithos_blocks else Decimal(0)
    )

    topup_per_block = (
        topup / lithos_blocks
        if lithos_blocks else Decimal(0)
    )

    inflow_per_block = (
        (genesis + topup) / lithos_blocks
        if lithos_blocks else Decimal(0)
    )

    boost = (
        topup / genesis * Decimal(100)
        if genesis else Decimal(0)
    )

    return {
        "lithos_blocks": lithos_blocks,
        "chain_blocks": chain_blocks,
        "genesis": genesis,
        "topup": topup,
        "priority": priority,
        "payout_reward": payout_reward,
        "payout_gross": payout_gross,
        "dex_gross": dex_gross,
        "dex_net": dex_net,
        "pool_dex": pool_dex,
        "local_dex_net": local_dex_net,
        "local_payout": local_payout,
        "other_topup": other_topup,
        "initial_per_block": initial_per_block,
        "topup_per_block": topup_per_block,
        "inflow_per_block": inflow_per_block,
        "boost": boost,
    }


