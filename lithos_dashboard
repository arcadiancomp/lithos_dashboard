def render_daily(buckets):
    print(
        "  "
        + col(f"{'UTC DATE':<11}", BOLD)
        + col(f"{'CHAIN':>7}", BOLD)
        + col(f"{'LITHOS':>8}", BOLD)
        + col(f"{'GENESIS':>11}", BOLD)
        + col(f"{'TOP-UP':>11}", BOLD)
        + col(f"{'BOOST':>9}", BOLD)
        + col(f"{'PRIORITY':>11}", BOLD)
        + col(f"{'DEX GROSS':>11}", BOLD)
        + col(f"{'PAYOUT':>11}", BOLD)
    )

    print("  " + col("─" * 90, DIM))

    if not buckets:
        print(col("  No daily buckets retained.", YELLOW))
        return

    for b in buckets:
        t = b.get("totals") or {}

        chain = num(t, "chain.blocks")
        lb = num(t, "lithos.blocks")

        genesis = erg(t, "holding.genesisNanoErg")
        topup = erg(t, "rollup.topUp.valueNanoErg")
        priority = erg(t, "lithos.priorityFeeNanoErg")

        dex = (
            erg(t, "batching.lithosdex.grossNanoErg")
            + erg(t, "batching.ergodex.grossNanoErg")
        )

        payout = erg(t, "network.payout.rewardNanoErg")

        boost = (
            topup / genesis * Decimal(100)
            if genesis else Decimal(0)
        )

        date = ms_date(b.get("start"))

        if lb > 0:
            date_s = col(f"{date:<11}", WHITE)
            lithos_s = col(f"{lb:>8}", CYAN, BOLD)
        else:
            date_s = col(f"{date:<11}", DIM)
            lithos_s = col(f"{lb:>8}", DIM)

        if topup > 0:
            topup_s = col(f"{fmt_erg(topup):>11}", GREEN)
            boost_s = col(f"{fmt_pct(boost):>9}", GREEN)
        else:
            topup_s = col(f"{'0.000':>11}", DIM)
            boost_s = col(f"{'-':>9}", DIM)

        payout_color = GREEN if payout > 0 else DIM

        print(
            "  "
            + date_s
            + f"{chain:>7}"
            + lithos_s
            + f"{fmt_erg(genesis):>11}"
            + topup_s
            + boost_s
            + f"{fmt_erg(priority):>11}"
            + f"{fmt_erg(dex):>11}"
            + col(f"{fmt_erg(payout):>11}", payout_color)
        )


