    else:
        state_badge = badge(state.upper(), "bad")

    lines.append(compact_kv("Commitment state", state_badge))
    lines.append(compact_kv("Chain height", col(f"{height:,}", BOLD, WHITE)))
    lines.append(compact_kv("Configured difficulty", col(config_diff, BOLD, CYAN)))

    inforce = c.get("inForce")
    if inforce:
        lines.append(
            compact_kv(
                "In-force difficulty",
                col(inforce.get("diff", "-"), BOLD, GREEN)
            )
        )

    pending = c.get("pending")
    if pending:
        lines.append(
            compact_kv(
                "Pending difficulty",
                col(pending.get("diff", "-"), BOLD, YELLOW)
            )
        )

    replaceable = integer(c.get("replaceableFromHeight"))
    if replaceable:
        remaining = max(0, replaceable - height)
        lines.append(
            compact_kv(
                "Next change allowed",
                f"{remaining:,} blocks @ {replaceable:,}"
            )
        )

    if not can_commit and blocked:
        lines.append(compact_kv("Commit control", col(blocked, YELLOW)))

    accepted = integer(w.get("acceptedShares"))
    rejected = integer(w.get("rejectedShares"))
    supers = integer(w.get("superShares"))
    sph = dec(w.get("superSharesPerHour"))
    candidates = integer(w.get("blockCandidates"))

    if rejected == 0:
        share_text = (
            col(f"{accepted:,} accepted", GREEN, BOLD)
            + " / "
            + col("0 rejected", GREEN)
        )
    else:
        share_text = (
            col(f"{accepted:,} accepted", GREEN)
            + " / "
            + col(f"{rejected:,} rejected", RED, BOLD)
        )

    lines.append(compact_kv("Shares this session", share_text))
    lines.append(compact_kv("Super shares", col(f"{supers:,}", BOLD, CYAN)))
    lines.append(compact_kv("Super shares / hour", col(fmt_rate(sph), BOLD, CYAN)))

    if candidates:
        lines.append(
            compact_kv("Block candidates", col(f"{candidates:,}", MAGENTA))
        )

    nisp = w.get("nisp") or {}
    held = bool(nisp.get("held"))
    nisp_count = integer(nisp.get("superSharesInWindow"))
    required = integer(nisp.get("required"), 10)

    nisp_text = badge(
        "NISP HELD" if held else "NISP NOT HELD",
        "good" if held else "bad"
    )
    nisp_text += f"  {nisp_count}/{required}"
    lines.append(compact_kv("NISP status", nisp_text))

    blocks_remaining = nisp.get("blocksRemaining")
    valid_through = nisp.get("validThroughHeight")
    if blocks_remaining is not None:
        remaining = integer(blocks_remaining)
        coverage = f"{remaining} blocks"
        if valid_through:
            coverage += f" through {integer(valid_through):,}"
        lines.append(
            compact_kv(
                "NISP coverage",
                col(coverage, GREEN if remaining >= 15 else YELLOW)
            )
        )

    return lines


def wide_nisp_and_adoption(state, opportunity_estimate, adoption):
    lines = []

    observed = integer(state.get("observedHeights"))
    lapse_heights = integer(state.get("lapseHeights"))
    events = integer(state.get("lapseEvents"))
    current = integer(state.get("currentLapseHeights"))
    longest = integer(state.get("longestLapseHeights"))

    availability = (
        100.0 * max(0, observed - lapse_heights) / observed
        if observed else 100.0
    )

    if availability >= 95.0:
        availability_color = GREEN
    elif availability >= 85.0:
        availability_color = YELLOW
    else:
        availability_color = RED

    lines.append(
        compact_kv(
            "NISP availability",
            col(f"{availability:.2f}%", BOLD, availability_color)
            + f"  ({max(0, observed - lapse_heights):,}/{observed:,})"
        )
    )
    lines.append(
        compact_kv(
            "Lapse events",
            col(f"{events:,}", GREEN if events == 0 else YELLOW)
        )
    )
    lines.append(
        compact_kv(
            "Heights with lapse",
            col(
                f"{lapse_heights:,}/{observed:,}",
                GREEN if lapse_heights == 0 else YELLOW
            )
        )
    )

    if current:
        lines.append(
            compact_kv(
                "Current lapse",
                col(f"{current:,} height(s)", RED, BOLD)
            )
        )

    lines.append(
        compact_kv(
            "Longest lapse",
            col(
                f"{longest:,} height(s)",
                GREEN if longest == 0 else YELLOW
            )
        )
    )

    started = state.get("trackingStartedHeight")
    if started:
        lines.append(
            compact_kv("NISP tracking since", f"{integer(started):,}")
        )

    last_lapse = state.get("lastLapseHeight")
    if last_lapse:
        lines.append(
            compact_kv("Last lapse", f"{integer(last_lapse):,}")
        )

    rollups = integer(state.get("rollupsObservedWithNispStatus"))
    eligible = integer(state.get("rollupsEligible"))
    missed = integer(state.get("rollupsMissed"))

    lines.append(
        compact_kv(
            "Rollup NISP sample",
            f"{rollups:,} ({eligible:,} eligible / {missed:,} unheld)"
        )
    )

    missed_initial = (
        Decimal(integer(state.get("missedRollupInitialNanoErg"))) / NANO
    )
    lines.append(
        compact_kv(
            "Missed pool value",
            col(
                f"{fmt_erg(missed_initial)} ERG",
                GREEN if missed == 0 else YELLOW
            )
        )
    )

    if opportunity_estimate is not None:
        lines.append(
            compact_kv(
                "Est. reward missed",
                col(
                    f"{fmt_erg(opportunity_estimate['erg'])} ERG",
                    RED if missed else GREEN,
                    BOLD
                )
            )
        )
        lines.append(
            compact_kv(
                "Opportunity model",
                col(
                    f"{float(opportunity_estimate['sharePct']):.1f}% share; "
                    f"{opportunity_estimate['sampleRollups']} rollups",
                    DIM
                )
            )
        )

    error = adoption.get("error")
    if error:
        lines.append(
            compact_kv(
                "Network adoption",
                col(safe_text(error), YELLOW)
            )
        )
        return lines

    network_hps = dec(adoption.get("networkHashrate"))
    if network_hps > 0:
        lines.append(
            compact_kv(
                "Ergo network hash",
                col(fmt_hashrate(network_hps), BOLD, WHITE)
            )
        )

    windows = adoption.get("windows") or {}
    for window in ADOPTION_WINDOWS:
        row = windows.get(window) or {}
        scanned = integer(row.get("scanned"))
        lithos = integer(row.get("lithos"))
        share = dec(row.get("share")) * Decimal(100)
        implied = dec(row.get("impliedHashrate"))
        lenders = integer(row.get("uniqueLenders"))

        if share >= Decimal("10"):
            share_color = GREEN
        elif share >= Decimal("3"):
            share_color = CYAN
        else:
            share_color = WHITE

        value = (
            f"{lithos}/{scanned}  "
            + col(f"{share:.2f}%", BOLD, share_color)
        )
        if network_hps > 0:
            value += "  " + col("~" + fmt_hashrate(implied), CYAN)
        value += f"  {lenders} lenders"

        lines.append(compact_kv(f"Last {window} blocks", value))

    return lines


